{
  "tools": [
    {
      "name": "check_location_warnings",
      "title": "Weather warnings for a place",
      "read_only": true,
      "required": [
        "location"
      ],
      "parameters": {
        "language": {
          "default": "id",
          "enum": [
            "id",
            "en"
          ],
          "type": "string"
        },
        "location": {
          "maxLength": 100,
          "minLength": 2,
          "type": "string"
        }
      },
      "result": [
        "data",
        "error",
        "meta",
        "status"
      ]
    },
    {
      "name": "get_current_weather",
      "title": "Current weather",
      "read_only": true,
      "required": [
        "adm4_code"
      ],
      "parameters": {
        "adm4_code": {
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{2}\\.\\d{4}$",
          "type": "string"
        }
      },
      "result": [
        "data",
        "error",
        "meta",
        "status"
      ]
    },
    {
      "name": "get_districts",
